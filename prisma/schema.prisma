generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TECHNICIAN
}

enum Gender {
  M
  F
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DebtStatus {
  PENDING
  PARTIAL
  PAID
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
}

enum ResultFlag {
  NORMAL
  HIGH
  LOW
}

enum NotificationType {
  ORDER_COMPLETED
  DEBT_DUE
  LOW_STOCK
  PAYMENT_RECEIVED
  NEW_ORDER
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  password      String
  role          Role           @default(TECHNICIAN)
  permissions   String[]       @default([])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  notifications Notification[]
}

model Patient {
  id          String          @id @default(cuid())
  firstName   String
  lastName    String
  dateOfBirth DateTime
  gender      Gender
  phone       String
  email       String?
  address     String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  orders      AnalysisOrder[]
}

model AnalysisType {
  id           String                @id @default(cuid())
  name         String
  code         String                @unique
  price        Float
  unit         String?
  refRangeMin  Float?
  refRangeMax  Float?
  refRangeText String?
  category     String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  orderItems   OrderAnalysis[]
  reagents     AnalysisTypeReagent[]
}

model AnalysisTypeReagent {
  id              String       @id @default(cuid())
  analysisTypeId  String
  analysisType    AnalysisType @relation(fields: [analysisTypeId], references: [id], onDelete: Cascade)
  productId       String
  product         Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantityPerTest Float        @default(1)

  @@unique([analysisTypeId, productId])
}

model AnalysisOrder {
  id          String          @id @default(cuid())
  patientId   String
  patient     Patient         @relation(fields: [patientId], references: [id])
  status      OrderStatus     @default(PENDING)
  totalAmount Float
  paidAmount  Float           @default(0)
  orderedAt   DateTime        @default(now())
  completedAt DateTime?
  notes       String?
  analyses    OrderAnalysis[]
  payments    Payment[]
}

model OrderAnalysis {
  id             String        @id @default(cuid())
  orderId        String
  order          AnalysisOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  analysisTypeId String
  analysisType   AnalysisType  @relation(fields: [analysisTypeId], references: [id])
  result         String?
  flag           ResultFlag?
  unit           String?
  refRange       String?
  completedAt    DateTime?
}

model Supplier {
  id        String     @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  purchases Purchase[]
  debts     Debt[]
}

model Product {
  id               String                @id @default(cuid())
  name             String
  reference        String?
  category         String?
  unit             String
  quantity         Float                 @default(0)
  minQuantity      Float                 @default(0)
  unitPrice        Float
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  purchaseItems    PurchaseItem[]
  analysisReagents AnalysisTypeReagent[]
}

model Purchase {
  id          String         @id @default(cuid())
  supplierId  String
  supplier    Supplier       @relation(fields: [supplierId], references: [id])
  totalAmount Float
  paidAmount  Float          @default(0)
  purchasedAt DateTime       @default(now())
  notes       String?
  items       PurchaseItem[]
  debt        Debt?
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Float
  unitPrice  Float
  total      Float
}

model Debt {
  id          String        @id @default(cuid())
  supplierId  String
  supplier    Supplier      @relation(fields: [supplierId], references: [id])
  purchaseId  String?       @unique
  purchase    Purchase?     @relation(fields: [purchaseId], references: [id])
  amount      Float
  remaining   Float
  dueDate     DateTime?
  status      DebtStatus    @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  payments    DebtPayment[]
}

model DebtPayment {
  id        String   @id @default(cuid())
  debtId    String
  debt      Debt     @relation(fields: [debtId], references: [id])
  amount    Float
  paidAt    DateTime @default(now())
  notes     String?
}

model Payment {
  id      String        @id @default(cuid())
  orderId String
  order   AnalysisOrder @relation(fields: [orderId], references: [id])
  amount  Float
  method  PaymentMethod @default(CASH)
  paidAt  DateTime      @default(now())
  notes   String?
}

model Expense {
  id          String   @id @default(cuid())
  description String
  amount      Float
  category    String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
}

model Notification {
  id        String           @id @default(cuid())
  userId    String?
  user      User?            @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())
}
